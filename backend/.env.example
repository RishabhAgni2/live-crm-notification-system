# --- PostgreSQL (Neon) ---
# Get this from your Neon project -> Connection Details -> "Pooled connection".
# Keep sslmode=require. Example:
# DATABASE_URL="postgresql://neondb_owner:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: Neon's "Direct connection" string, only needed if you set
# directUrl in prisma/schema.prisma to run migrations through the unpooled
# connection. Not required to just run the app.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Redis (used by Bull for the background job queue) ---
# Local: install Redis and run `redis-server`, then use the default below.
# Hosted (e.g. Upstash free tier): use the rediss:// URL they give you.
REDIS_URL="redis://127.0.0.1:6379"

# --- Auth ---
JWT_SECRET="change_this_to_a_long_random_string"

# --- Server ---
PORT=3000
CORS_ORIGIN="http://localhost:5173"
