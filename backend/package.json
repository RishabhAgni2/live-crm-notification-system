{
  "name": "crm-notification-backend",
  "version": "1.0.0",
  "description": "Live CRM Notification System - backend (Node.js + Express + PostgreSQL/Neon + Bull + Socket.io)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n API,WORKER -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "nodemon src/server.js",
    "dev:worker": "nodemon src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "prisma": "^6.1.0"
  }
}
